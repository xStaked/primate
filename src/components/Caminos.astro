---
---

<section class="caminos" id="caminos">
  <div class="container">
    <p class="lab">PRM — 003 · Dos formas, una misma idea</p>
    <h2 class="display">¿Cuál es <em>tu camino?</em></h2>

    <svg
      class="bifurcacion"
      viewBox="0 0 800 120"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <path
        d="M400 8 C 400 50, 400 50, 180 100 M400 8 C 400 50, 400 50, 620 100"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <circle cx="400" cy="8" r="7" fill="var(--acid)" />
      <circle cx="180" cy="100" r="5" fill="var(--magenta)" />
      <circle cx="620" cy="100" r="5" fill="var(--ember)" />
      <text x="400" y="34" text-anchor="middle" class="svg-label">PRIMATE</text>
    </svg>

    <div class="dos">
      <a href="#gnosis" class="camino gnosis">
        <p class="lab">Camino 01 — Hacia adentro</p>
        <h3 class="display">Gnosis</h3>
        <p class="para">Para quienes quieren explorar.</p>
        <p class="tags">Psicodelia · Introspección · Percepción · Conciencia</p>
        <span class="cta">Explorar Gnosis →</span>
      </a>
      <a href="#mind" class="camino mind">
        <p class="lab">Camino 02 — Hacia adelante</p>
        <h3 class="display">Mind</h3>
        <p class="para">Para quienes quieren avanzar.</p>
        <p class="tags">Adaptógenos · Rutina · Enfoque · Energía</p>
        <span class="cta">Explorar Mind →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .caminos {
    background: var(--void);
    color: var(--text-on-dark);
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--text-on-dark) 12%, transparent);
  }
  h2 {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    margin: 1rem 0 0.5rem;
  }
  h2 em {
    color: var(--acid);
  }
  .bifurcacion {
    width: 100%;
    max-width: 640px;
    height: auto;
    margin: 1rem auto 2.5rem;
    display: block;
    opacity: 0.9;
  }
  .svg-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 4px;
    fill: currentColor;
  }
  .dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .camino {
    text-decoration: none;
    border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: block;
    transition: transform 160ms ease-out;
  }
  .camino:hover {
    transform: translateY(-4px);
  }
  .camino.gnosis {
    background: var(--ink);
    border: 1px solid color-mix(in srgb, var(--magenta) 45%, transparent);
  }
  .camino.mind {
    background: var(--bone);
    color: var(--text-on-light);
    border: 1px solid var(--sand);
  }
  h3 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    margin: 0.75rem 0 0.5rem;
  }
  .para {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
  }
  .tags {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    opacity: 0.7;
    margin: 0 0 1.75rem;
  }
  .cta {
    font-weight: 600;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .gnosis .cta {
    color: var(--magenta);
  }
  .mind .cta {
    color: var(--ember);
  }
  @media (max-width: 760px) {
    .dos {
      grid-template-columns: 1fr;
    }
  }
</style>
