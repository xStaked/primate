---
---

<section class="hero grain" id="top">
  <div class="hero-bg" aria-hidden="true">
    <img src="/images/hero-rostro.jpg" alt="" fetchpriority="high" data-parallax="0.08" />
  </div>
  <div class="container hero-inner">
    <p class="lab" data-hero="kicker">Bienestar · Enfoque · Transformación</p>
    <h1 class="display" data-hero="title">
      <span class="line-mask"><span class="line">Tu mente</span></span>
      <span class="line-mask"><span class="line">es el <em>territorio.</em></span></span>
    </h1>
    <p class="lede" data-hero="lede">
      Primate es el universo para el hombre que quiere dominar su energía, afinar su enfoque y
      transformar su rutina. Exploración con método. Intensidad con control.
    </p>
    <div class="actions" data-hero="cta">
      <a href="#productos" class="btn btn-ember">Explorar la colección</a>
      <a href="#metodo" class="btn btn-ghost">Conocer el método</a>
    </div>
    <div class="hero-meta" data-hero="meta">
      <span class="lab">GNOSIS — Explorar</span>
      <span class="rule" aria-hidden="true"></span>
      <span class="lab">MIND — Rendir</span>
    </div>
  </div>
  <p class="vertical hero-side" aria-hidden="true">PRM — 001 · Estado de dominio</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding: calc(72px + 3rem) 0 4rem;
  }
  .hero-bg {
    position: absolute;
    inset: -12% 0;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(11, 10, 8, 0.94) 22%, rgba(11, 10, 8, 0.55) 55%, rgba(11, 10, 8, 0.25) 100%),
      linear-gradient(to top, var(--void) 2%, transparent 30%);
  }
  .hero-inner {
    position: relative;
  }
  h1 {
    font-size: clamp(3.4rem, 9vw, 7.5rem);
    margin: 1.2rem 0 1.5rem;
    text-transform: uppercase;
  }
  h1 em {
    color: var(--ember);
  }
  .line-mask {
    display: block;
    overflow: hidden;
  }
  .line {
    display: block;
    will-change: transform;
  }
  .lede {
    font-size: 1.18rem;
    color: var(--muted-on-dark);
    max-width: 36rem;
    margin: 0 0 2.2rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .rule {
    flex: 0 0 120px;
    height: 1px;
    background: color-mix(in srgb, var(--text-on-dark) 30%, transparent);
  }
  .hero-side {
    position: absolute;
    right: 1.4rem;
    bottom: 4rem;
  }
  @media (max-width: 760px) {
    .hero-bg img {
      object-position: 62% center;
    }
    .hero-side {
      display: none;
    }
  }
</style>
