<header class="nav">
  <div class="progress" data-progress aria-hidden="true"></div>
  <div class="container nav-inner">
    <a href="#top" class="wordmark" aria-label="Primate — inicio">PRIMATE<sup>®</sup></a>
    <nav aria-label="Navegación principal">
      <a href="#manifiesto">Manifiesto</a>
      <a href="#metodo">Método</a>
      <a href="#gnosis">Gnosis</a>
      <a href="#mind">Mind</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href="#productos" class="nav-cta">Explorar la colección</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: color-mix(in srgb, var(--void) 78%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--text-on-dark) 12%, transparent);
  }
  .progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ember);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 72px;
  }
  .wordmark {
    font-weight: 700;
    letter-spacing: 0.24em;
    font-size: 1rem;
    text-decoration: none;
  }
  .wordmark sup {
    font-size: 0.55em;
    letter-spacing: 0;
    opacity: 0.6;
  }
  nav {
    display: flex;
    gap: 1.75rem;
  }
  nav a {
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--muted-on-dark);
  }
  nav a:hover {
    color: var(--ember);
  }
  .nav-cta {
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    background: var(--ember);
    color: #fff;
    border-radius: 999px;
    padding: 0.65rem 1.35rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: background 160ms ease-out;
  }
  .nav-cta:hover {
    background: var(--text-on-dark);
    color: var(--void);
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
</style>
