---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import Manifiesto from '@/components/Manifiesto.astro';
import Metodo from '@/components/Metodo.astro';
import Gnosis from '@/components/Gnosis.astro';
import Mind from '@/components/Mind.astro';
import Productos from '@/components/Productos.astro';
import Ingredientes from '@/components/Ingredientes.astro';
import Ritual from '@/components/Ritual.astro';
import Testimonios from '@/components/Testimonios.astro';
import Faq from '@/components/Faq.astro';
import Cierre from '@/components/Cierre.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="Primate — Tu mente es el territorio"
  description="Primate: bienestar, enfoque y transformación. MIND para rendir cada día, GNOSIS para explorar hacia adentro. Conoce el método, la colección y el ritual."
>
  <Navbar />
  <main>
    <Hero />
    <Marquee />
    <Manifiesto />
    <Metodo />
    <Gnosis />
    <Mind />
    <Productos />
    <Ingredientes />
    <Ritual />
    <Testimonios />
    <Faq />
    <Cierre />
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../lib/motion.ts';
</script>
