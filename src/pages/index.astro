---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Hero from '@/components/Hero.astro';
import Manifiesto from '@/components/Manifiesto.astro';
import Mundos from '@/components/Mundos.astro';
import Caminos from '@/components/Caminos.astro';
import Filosofia from '@/components/Filosofia.astro';
import Productos from '@/components/Productos.astro';
import NoTodos from '@/components/NoTodos.astro';
import Cierre from '@/components/Cierre.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="Primate — Explora tu mente. Expande tu perspectiva."
  description="Primate nace de la curiosidad por entender mejor nuestra mente y percepción. Gnosis para explorar nuevos estados. Mind para acompañar tu día a día."
>
  <Navbar />
  <main>
    <Hero />
    <Manifiesto />
    <Mundos />
    <Caminos />
    <Filosofia />
    <Productos />
    <NoTodos />
    <Cierre />
  </main>
  <Footer />
</BaseLayout>
